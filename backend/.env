# Database Configuration (PostgreSQL - RENDER)
DATABASE_URL=postgresql://westernpumps_bvrn_user:qe7VlPibo0ZXdhdWCCSTeQoWynXUPQr1@dpg-d8j404eq1p3s73fah45g-a.oregon-postgres.render.com/westernpumps_bvrn

# JWT & Security
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters-required
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURITY_HEADERS_ENABLED=true

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://western-pumps.vercel.app

# Database Setup
AUTO_CREATE_TABLES=true
DISABLE_AUTH=false
ENABLE_AUTH_BOOTSTRAP=false

# Admin Seeding (optional - set to populate initial admin user)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=

# Approval Thresholds
APPROVAL_THRESHOLD_MANAGER=5000
APPROVAL_THRESHOLD_ADMIN=20000

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# SMS/Twilio Configuration (optional)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Configuration (optional)
WHATSAPP_ENABLED=false
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=

# Security & Compliance
ENFORCE_HTTPS=false
REQUEST_ID_HEADER=X-Request-ID
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:
PERMISSIONS_POLICY=geolocation=(self), camera=(self), microphone=()

# Multi-Tenant Configuration
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT_ID=1
COMPLIANCE_MODE=standard

# OIDC Configuration (optional)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_NAME=name
OIDC_CLAIM_ROLES=roles
OIDC_AUTO_PROVISION_USERS=false
OIDC_ROLE_MAPPING_JSON={}

# Background Workers
OUTBOX_WORKER_POLL_INTERVAL_SECONDS=3
OUTBOX_WORKER_BATCH_SIZE=30

# ERP Integration (optional)
INTEGRATION_ERP_ENABLED=false
INTEGRATION_ERP_API_BASE=
INTEGRATION_ERP_WEBHOOK=
INTEGRATION_ERP_WEBHOOK_SECRET=

# Accounting Integration (optional)
INTEGRATION_ACCOUNTING_ENABLED=false
INTEGRATION_ACCOUNTING_API_BASE=
INTEGRATION_ACCOUNTING_WEBHOOK=
INTEGRATION_ACCOUNTING_WEBHOOK_SECRET=

# AI & OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Developer Tools
DEVELOPER_EMAIL=
DEVELOPER_PURGE_TOKEN=
